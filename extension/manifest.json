{
  "manifest_version": 3,
  "name": "Flux Sniffer",
  "version": "0.3.2",
  "description": "Trouve et teste les flux audio (Icecast, Shoutcast, HLS) d'un site radio, sans passer par l'onglet Network.",
  "minimum_chrome_version": "110",
  "permissions": [
    "webRequest",
    "storage",
    "scripting",
    "declarativeNetRequest",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Flux Sniffer",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "popup/panel.html"
  }
}
